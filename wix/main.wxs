<?xml version="1.0" encoding="UTF-8"?>
<Wix
  xmlns="http://wixtoolset.org/schemas/v4/wxs"
  xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
    Name="Run Config Manager"
    Version="$(PackageVersion)"
    Manufacturer="Run Config Manager"
    Language="1033"
    UpgradeCode="edd5601c-e5f4-45f1-bce2-41cadc8ff01a"
    UpgradeStrategy="majorUpgrade"
    Scope="perMachine">
    <MajorUpgrade
      Schedule="afterInstallInitialize"
      DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <Media Id="1" Cabinet="media1.cab" EmbedCab="yes" />

    <Icon Id="AppIcon.ico" SourceFile="$(SourceDir)\packaging\windows\AppIcon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <WixVariable
      Id="WixUILicenseRtf"
      Value="$(SourceDir)\packaging\windows\License.rtf" />
    <UI Id="InstallerUI">
      <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
      <Publish
        Dialog="ExitDialog"
        Control="Finish"
        Property="WixShellExecTarget"
        Value="[INSTALLFOLDER]run_config_manager.exe"
        Order="1"
        Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
      <Publish
        Dialog="ExitDialog"
        Control="Finish"
        Event="DoAction"
        Value="LaunchApplication"
        Order="2"
        Condition="WixShellExecTarget and WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
    </UI>
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="Run Config Manager has been installed." />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Run Config Manager" />
    <CustomAction
      Id="LaunchApplication"
      BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
      DllEntry="WixShellExec"
      Impersonate="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Run Config Manager" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Run Config Manager" />
    </StandardDirectory>

    <ComponentGroup Id="MainComponents" Directory="INSTALLFOLDER">
      <Component Id="ApplicationComponent" Bitness="always64">
        <File
          Id="ApplicationFile"
          Source="$(SourceDir)\target\release\run_config_manager.exe"
          KeyPath="yes">
          <Shortcut
            Id="ApplicationStartMenuShortcut"
            Name="Run Config Manager"
            Directory="ApplicationProgramsFolder"
            Description="Run/Debug configuration management tool"
            WorkingDirectory="INSTALLFOLDER"
            Icon="AppIcon.ico"
            IconIndex="0"
            Advertise="yes" />
        </File>
      </Component>

      <Component Id="LicenseComponent" Bitness="always64">
        <File
          Id="LicenseFile"
          Source="$(SourceDir)\LICENSE"
          Name="LICENSE"
          KeyPath="yes" />
      </Component>

      <Component Id="ReadmeComponent" Bitness="always64">
        <File
          Id="ReadmeFile"
          Source="$(SourceDir)\README.md"
          Name="README.md"
          KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Component Id="StartMenuFolderComponent" Directory="ApplicationProgramsFolder" Bitness="always64">
      <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
      <RegistryValue
        Root="HKLM"
        Key="Software\RunConfigManager"
        Name="Installed"
        Type="integer"
        Value="1"
        KeyPath="yes" />
    </Component>

    <Feature Id="MainFeature" Title="Run Config Manager" Level="1">
      <ComponentGroupRef Id="MainComponents" />
      <ComponentRef Id="StartMenuFolderComponent" />
    </Feature>
  </Package>
</Wix>
